# Copy to .env.local (git-ignored) and fill in. EXPO_PUBLIC_ values are bundled into the app,
# so only put public keys here: never the Supabase service-role key.
EXPO_PUBLIC_API_URL=https://nimo-app-backend.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
